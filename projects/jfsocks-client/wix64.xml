<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:fire="http://wixtoolset.org/schemas/v4/wxs/firewall" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package UpgradeCode="{F7C8A6C3-3529-43D7-96CC-F4395633F82A}" Version="0.18" Language="1033" Name="jfSOCKS-Client" Manufacturer="Peter Quiring" InstallerVersion="300">
    <Media Id="1" Cabinet="files.cab" EmbedCab="yes" />
    <UIRef Id="WixUI_Minimal" />
    <MajorUpgrade DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit." />

    <Icon Id="icon.ico" SourceFile="jfsocks-client.ico" />
    <Property Id="ARPPRODUCTICON" Value="icon.ico" />

    <!-- Step 1: Define the directory structure -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="APPLICATIONROOTDIRECTORY" Name="jfsocks-client" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
<!-- Use the following if you want Shortcut in its own folder -->
<!--        <Directory Id="ApplicationProgramsFolder" Name="jfSOCKS-Client"/> -->
    </StandardDirectory>

    <!-- Step 2: Add files to your installer package -->
    <DirectoryRef Id="APPLICATIONROOTDIRECTORY">
      <Component Id="appfiles" Guid="{0AE44821-3155-4352-96CB-A33B702065DE}" Bitness="always64">
        <File Id="jfsocks_client.exe" Source="jfsocks-client.exe" KeyPath="yes">
          <fire:FirewallException Id="FirewallRule" Name="jfSOCKS-Client" Protocol="tcp" Port="1080" Scope="any" IgnoreFailure="yes" Profile="all" />
        </File>
        <File Id="javaforce.jar" Source="javaforce.jar" />
        <File Id="jfsocks_client.jar" Source="jfsocks-client.jar" />
        <ServiceInstall Id="ServiceInstaller" Type="ownProcess" Name="jfSOCKS-Client" DisplayName="jfSOCKS-Client" Description="jf SOCKS Client" Start="auto" ErrorControl="normal" />
        <ServiceControl Id="StartService" Start="install" Stop="both" Remove="uninstall" Name="jfSOCKS-Client" Wait="yes" />
      </Component>
    </DirectoryRef>

    <!-- Step 2b: Add the shortcut to your installer package -->
<!-- Change Id to ApplicationProgramsFolder if you want Shortcut in its own folder -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcut" Guid="{FADFAB5B-DBE9-4F92-BC45-8B65845D6704}">
        <RegistryValue Root="HKCU" Key="Software\Microsoft\jfSOCKS-Client" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        <Shortcut Id="ApplicationStartMenuShortcut2" Name="jfSOCKS Client" Description="SOCKS Client" Target="[APPLICATIONROOTDIRECTORY]jfsocks-client.exe" WorkingDirectory="APPLICATIONROOTDIRECTORY" />
<!-- Use the following if you want Shortcut in its own folder -->
<!--        <RemoveFolder Id="ApplicationProgramsFolder2" On="uninstall"/> -->
      </Component>
    </StandardDirectory>

    <!-- Step 3: Tell WiX to install the files -->
    <Feature Id="MainApplication" Title="Main Application" Level="1">
      <ComponentRef Id="appfiles" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentGroupRef Id="JRE" />
    </Feature>

    </Package>
</Wix>
