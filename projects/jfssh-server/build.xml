<project name="jfssh-server" default="jar" basedir=".">
  <!-- set global properties for this build -->
  <property name="app" value="jfssh-server"/>
  <property name="apptype" value="service"/>
  <property name="home" value="../.."/>
  <property name="version" value="0.3"/>
  <property name="jre" location="${home}/jre_base"/>

  <import file="${home}/base.xml"/>

  <target name="depjars" depends="jar-sshd-core,jar-sshd-common,jar-sshd-sftp,jar-sshd-scp,jar-slf4j-api,jar-log4j-api,jar-log4j-core,depnatives">
  </target>

  <target name="compile" depends="depjars" description="compile the source">
  </target>

  <target name="jar" depends="depjars,compile" description="build jar file">
  </target>

  <target name="install" description="install files for linux">
    <copy file="${app}.service" todir="/lib/systemd/system"/>
    <copy file="${app}.cfg" todir="/etc/javaforce/admin"/>
  </target>
</project>
